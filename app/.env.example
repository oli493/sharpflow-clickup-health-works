# Sharpflow ClickUp Health (app) — environment variables (names only)
# Copy to .env.local and fill in. Never commit real values.

# ClickUp OAuth app (registered in a Sharpflow workspace)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
# Dev: http://localhost:3000/api/clickup/callback
CLICKUP_REDIRECT_URI=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct/pooled Postgres connection for migrations and the worker
SUPABASE_DB_URL=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# LLM (explanations only)
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Required when LLM_API_KEY is a user-scoped key (sk-ant-usr-...): the Anthropic workspace id.
LLM_WORKSPACE_ID=

# Lead capture destination (Sharpflow ClickUp CRM)
LEAD_CAPTURE_WEBHOOK=
LEAD_CAPTURE_LIST_ID=
# Workspace-scoped ClickUp personal token with access to the CRM List
LEAD_CAPTURE_CLICKUP_TOKEN=

# Token encryption key (32-byte hex/base64 for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=

# Public base URL (used to build the OAuth redirect/callback links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
