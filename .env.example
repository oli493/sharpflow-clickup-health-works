# Sharpflow ClickUp Health — environment variables (names only)
# Copy to .env.local and fill in. Never commit real values.

# ClickUp OAuth app (created by a Sharpflow workspace owner/admin)
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=

# Database
DATABASE_URL=

# LLM (OpenAI or Anthropic) — explanations only, never scoring
LLM_API_KEY=

# Lead capture destination (CRM / email webhook) — optional
LEAD_CAPTURE_WEBHOOK=
